{
  "name": "whendow-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "http://localhost:8000/whendow.ui",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev --port 8000",
    "local": "vite --mode dev --port 8000",
    "build": "vite build",
    "build-safe": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test -c playwright-ct.config.ts",
    "test:visual:update": "playwright test -c playwright-ct.config.ts --update-snapshots"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.56.2",
    "canvas-confetti": "^1.9.4",
    "classnames": "^2.5.1",
    "graphql": "^16.9.0",
    "graphql-request": "^7.1.0",
    "modern-normalize": "^3.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "styled-components": "^6.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/experimental-ct-react": "1.61.0",
    "@playwright/test": "1.61.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsdom": "^30",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
